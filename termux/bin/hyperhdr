#!/usr/bin/env bash
# HyperHDR v24.0.0-beta.0 Headless CLI Launcher for Termux (Android)
set -e

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HYPERHDR_HOME="${HYPERHDR_HOME:-$PREFIX/opt/hyperhdr}"
USERDATA_DIR="${HYPERHDR_USERDATA:-$HOME/.hyperhdr}"
PID_FILE="$USERDATA_DIR/hyperhdr.pid"
LOG_FILE="$USERDATA_DIR/hyperhdr.log"
MODE="${HYPERHDR_MODE:-auto}"

mkdir -p "$USERDATA_DIR"

# Parse wrapper-specific flags while preserving standard HyperHDR flags
PASS_ARGS=()
for arg in "$@"; do
    case "$arg" in
        --mode=*)
            MODE="${arg#*=}"
            ;;
        --glibc|--native-elf)
            MODE="glibc"
            ;;
        --proot)
            MODE="proot"
            ;;
        --py|--python)
            MODE="py"
            ;;
        start|--bg|--daemon)
            if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
                echo "HyperHDR v24.0.0-beta.0 is already running (PID $(cat "$PID_FILE"))."
                echo "Web UI: http://$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' || echo 127.0.0.1):8090"
                exit 0
            fi
            command -v termux-wake-lock >/dev/null 2>&1 && termux-wake-lock || true
            nohup "$0" --mode="$MODE" -d > "$LOG_FILE" 2>&1 &
            echo $! > "$PID_FILE"
            sleep 1
            echo "HyperHDR v24.0.0-beta.0 started in background (PID $(cat "$PID_FILE"))."
            echo "  Web UI      : http://127.0.0.1:8090 (or http://<device-lan-ip>:8090)"
            echo "  JSON-RPC    : tcp://127.0.0.1:19444"
            echo "  FlatBuffers : tcp://127.0.0.1:19400"
            echo "  Protobuf    : tcp://127.0.0.1:19445"
            echo "  Logs        : hyperhdr logs  ($LOG_FILE)"
            exit 0
            ;;
        stop)
            if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
                kill "$(cat "$PID_FILE")" 2>/dev/null || true
                rm -f "$PID_FILE"
                command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock || true
                echo "HyperHDR stopped."
            else
                pkill -f "hyperhdr" 2>/dev/null || true
                rm -f "$PID_FILE"
                echo "HyperHDR is not running."
            fi
            exit 0
            ;;
        status)
            if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
                echo "HyperHDR v24.0.0-beta.0 is RUNNING (PID $(cat "$PID_FILE"))."
                echo "  Web UI   : http://127.0.0.1:8090"
                echo "  Log tail :"
                tail -n 10 "$LOG_FILE" 2>/dev/null || true
            else
                echo "HyperHDR is STOPPED."
            fi
            exit 0
            ;;
        logs)
            exec tail -n 50 -f "$LOG_FILE"
            ;;
        *)
            PASS_ARGS+=("$arg")
            ;;
    esac
done

run_glibc_elf() {
    local LD_SO="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
    local ELF_BIN="$HYPERHDR_HOME/usr/bin/hyperhdr"
    local LIB_BASE="$HYPERHDR_HOME/usr/lib/hyperhdr"
    local LIB_PATH="$LIB_BASE:$LIB_BASE/external:$PREFIX/glibc/lib"
    export QT_PLUGIN_PATH="$LIB_BASE/external/plugins"
    # Also start background Android MediaProjection (UDP :19446) / screencap -> JSON-RPC (:19444) bridge for native ELF mode
    if [ "${HYPERHDR_SCREENCAP_BRIDGE:-1}" = "1" ] && command -v python3 >/dev/null 2>&1; then
        python3 - << 'PYBRIDGE' >/dev/null 2>&1 &
import base64, json, os, socket, struct, subprocess, threading, time
time.sleep(2.0)

def send_frame(rgb, dw, dh):
    req = json.dumps({
        "command": "image",
        "priority": 240,
        "duration": 3000,
        "format": "auto",
        "imagewidth": dw,
        "imageheight": dh,
        "origin": "Android MediaProjection API",
        "name": "Android MediaProjection API",
        "imagedata": base64.b64encode(bytes(rgb)).decode("ascii"),
    }) + "\n"
    with socket.create_connection(("127.0.0.1", 19444), timeout=0.5) as s:
        s.sendall(req.encode("utf-8"))

last_mp_ts = [0.0]

def mp_udp_loop():
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        sock.bind(("127.0.0.1", 19446))
        while True:
            data, _ = sock.recvfrom(65535)
            if len(data) >= 12 and data[:4] == b"HHMP":
                bw, bh = struct.unpack("!HH", data[4:8])
                rgb = data[8:]
                if bw > 0 and bh > 0 and len(rgb) >= bw * bh * 3:
                    last_mp_ts[0] = time.time()
                    send_frame(rgb[:bw * bh * 3], bw, bh)
    except Exception:
        pass

threading.Thread(target=mp_udp_loop, daemon=True).start()

try:
    env = os.environ.copy()
    env.pop("LD_PRELOAD", None)
    subprocess.Popen([
        "/system/bin/am", "start", "--user", "0",
        "-n", "org.hyperhdr.androidtv/.MainActivity",
        "-a", "org.hyperhdr.androidtv.ACTION_REQUEST_MEDIA_PROJECTION",
        "--ez", "headless_bridge", "true"
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
except Exception:
    pass

while True:
    if (time.time() - last_mp_ts[0]) < 1.5:
        time.sleep(0.1)
        continue
    try:
        env = os.environ.copy()
        env.pop("LD_PRELOAD", None)
        env["LD_LIBRARY_PATH"] = "/system/lib64:/system/lib"
        p = subprocess.Popen(["/system/bin/screencap"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
        raw = p.communicate(timeout=1.5)[0]
        if p.returncode == 0 and len(raw) > 64:
            w, h, _ = struct.unpack_from("<III", raw, 0)
            hdr_sz = 16 if len(raw) >= 16 + w * h * 4 else 12
            if 0 < w <= 7680 and 0 < h <= 4320 and len(raw) >= hdr_sz + w * h * 4:
                dw, dh = 192, 108
                rgb = bytearray(dw * dh * 3)
                mv = memoryview(raw)[hdr_sz:]
                idx = 0
                for dy in range(dh):
                    sy = (dy * h) // dh
                    roff = sy * w * 4
                    for dx in range(dw):
                        sx = (dx * w) // dw
                        poff = roff + sx * 4
                        rgb[idx:idx+3] = mv[poff:poff+3]
                        idx += 3
                send_frame(rgb, dw, dh)
    except Exception:
        pass
    time.sleep(0.15)
PYBRIDGE
    fi
    exec "$LD_SO" --library-path "$LIB_PATH" "$ELF_BIN" --desktop -u "$USERDATA_DIR" "${PASS_ARGS[@]}"
}

run_proot_debian() {
    exec proot-distro login debian --shared-tmp -- /usr/bin/hyperhdr --desktop -u "$USERDATA_DIR" "${PASS_ARGS[@]}"
}

run_python_daemon() {
    exec python3 "$HYPERHDR_HOME/pydaemon/hyperhdr_termux_daemon.py" \
        --assets "$HYPERHDR_HOME/share/hyperhdr" \
        --userdata "$USERDATA_DIR" \
        "${PASS_ARGS[@]}"
}

case "$MODE" in
    glibc)
        run_glibc_elf
        ;;
    proot)
        run_proot_debian
        ;;
    py)
        run_python_daemon
        ;;
    auto|*)
        if [ -x "$PREFIX/glibc/lib/ld-linux-aarch64.so.1" ] && [ -f "$HYPERHDR_HOME/usr/lib/hyperhdr/external/libdbus-1.so.3" ]; then
            run_glibc_elf
        elif command -v proot-distro >/dev/null 2>&1 && [ -x "$PREFIX/var/lib/proot-distro/installed-rootfs/debian/usr/bin/hyperhdr" ]; then
            run_proot_debian
        else
            run_python_daemon
        fi
        ;;
esac
